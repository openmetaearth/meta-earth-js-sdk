{
  "name": "metaearth-sdk-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:evm-example": "node scripts/compile-evm-example.mjs",
    "predev": "pnpm --dir ../.. build && pnpm run compile:evm-example",
    "prebuild": "pnpm --dir ../.. build && pnpm run compile:evm-example",
    "dev": "rimraf node_modules/.vite && vite --host",
    "build": "rimraf node_modules/.vite && tsc && vite build",
    "preview": "vite preview",
    "clean": "rimraf node_modules/.vite"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "antd": "^6.0.0",
    "meta-earth-js-sdk": "file:../..",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "rimraf": "^6.1.0",
    "solc": "0.8.30",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
